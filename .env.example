# Copy to .env for local testing (.env is gitignored). On Render, set these in Environment instead.
# Use a separate Neon branch for local testing, never the main (live) one.
DATABASE_URL=postgresql://user:password@ep-something.neon.tech/neondb?sslmode=require
ADMIN_PIN=
# Optional: a local or Neon test database for `npm test` (tests use a throwaway schema and delete it).
TEST_DATABASE_URL=
